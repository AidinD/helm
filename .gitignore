node_modules/
dist/
# Written by scripts/build.mjs at package time (the git-computed version baked
# into the packaged app); regenerated on every build, never committed.
src/lib/build-version.json
config.json
domains.json
usage-log.jsonl
helm-usage.jsonl
goal-run-history.json
mates.json
second-mates.json
scheduled-prompts.json
# Temp files from the shared atomic write (tmp + rename). Cleanup is best-effort,
# so a kill at the wrong moment leaves one behind - and an un-ignored leftover
# would otherwise be committed, or packaged into an installer (see build.files).
.*.tmp
routines.json
pasted-images/
# whisper.cpp CUDA binary + GGML model for voice transcription (see
# src/lib/whisperCpp.js and docs/transcription-research.md) — ~1.5GB of
# CUDA DLLs and model weights, installed manually per-machine, never
# committed.
.whisper/

# Ad-hoc flow-review inspection screenshots (see inspect-flow.mjs)
scripts/checks-lib/screenshots/flow-review/

# The orchestration dispatch queue + budget/kill-switch live at
# <metaHome>/.helm-dispatch/. That's an ABSOLUTE meta-home dir, never inside the
# repo - but a metaHome mangled to a relative path (e.g. a bash-heredoc-stripped
# Windows path, `D:\Dropbox\...` -> `DropboxDocumentsClaude`) once landed a
# stray `.helm-dispatch/budget.json` under the repo cwd (2026-08-12). The code
# guard in src/lib/orchestrationBudget.js now refuses that; this line is the
# belt-and-suspenders so such an artifact can never be committed if one recurs.
.helm-dispatch/

# The goal orchestrator's own scratch files, written INSIDE the worktree it runs
# in (notes.md = its research, plan.md = its plan, phase.json = where it is).
# Not ignored until 2026-08-03, so every autonomous run committed 50-250 lines of
# its own working notes onto its branch - which would have landed on master the
# moment such a branch was merged. The real artifacts are the code commits; the
# notes are recoverable from the run's own transcript.
.helm-goal/

scripts/checks-lib/screenshots/frameless-header.png

# Screenshot and capture output. Never committed - a screenshot of your own app
# shows whatever was on screen. Helm had seven of these in a public repo before
# anyone noticed; see keel/hooks/no-leaky-assets.mjs.
screenshots/
**/screenshots/
captures/
**/captures/
