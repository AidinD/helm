{
  "name": "helm",
  "version": "0.1.0",
  "private": true,
  "description": "Personal orchestrator harness over Claude Code sessions \u2014 overview, rooting, and rooted-session launch. Wraps the real claude CLI.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build.mjs",
    "release": "node scripts/build.mjs --publish",
    "test": "node scripts/run-tests.mjs",
    "test:fast": "node scripts/run-tests.mjs --fast"
  },
  "build": {
    "appId": "com.aidin.helm",
    "productName": "Helm",
    "files": [
      "**/*",
      "!.whisper/**/*",
      "!docs/**/*",
      "!spike/**/*",
      "!scripts/**/*",
      "!*.md",
      "!config.json",
      "!domains.json",
      "!goal-run-history.json",
      "!helm-usage.jsonl",
      "!mates.json",
      "!routines.json",
      "!usage-log.jsonl",
      "!**/.*.tmp",
      "!scheduled-prompts.json",
      "!second-mates.json",
      "!node_modules/onnxruntime-web/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/assets/helm-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AidinD",
        "repo": "helm",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "../jot/out/renderer",
        "to": "jot/out/renderer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/jot-webview-preload.cjs",
        "to": "jot/jot-webview-preload.cjs"
      }
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@jot/core": "file:../jot/dist-core",
    "electron-updater": "^6.3.9"
  }
}
